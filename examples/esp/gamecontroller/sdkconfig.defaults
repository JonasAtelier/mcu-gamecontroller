# All three pads on one ESP32: Bluetooth Classic for DS4/DS5 and BLE for
# Xbox, the controller in dual mode.
CONFIG_IDF_TARGET="esp32"
CONFIG_BT_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_HID_ENABLED=y
CONFIG_BT_HID_HOST_ENABLED=y
CONFIG_BT_GATTC_NOTIF_REG_MAX=16
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_GAMECONTROLLER_DS4=y
CONFIG_GAMECONTROLLER_DS5=y
CONFIG_GAMECONTROLLER_XBOX=y
CONFIG_GAMECONTROLLER_MAX_PADS=2
